// ============================================================
// KycAttestationV1: shared KYC attestation format (version 1)
//
// The interface between a CASP (KYC provider) and any Midnight
// contract that accepts its attestations. The CASP signs exactly these
// messages; contracts verify exactly these messages.
//
// Canonical copy: eu-counterparty-simulator/compact/KycAttestationV1.compact
// Vendored copies must be byte-identical (checked by sha256 in each repo).
// Never edit in place: a format change is a new module (KycAttestationV2)
// with new domain tags, so old signatures can never verify as new ones.
//
// Signature scheme: Schnorr over Jubjub.
//   R = k*G,  c = transientHash(Rx, Ry, pkx, pky, msg),
//   c' = c mod 2^248 (valid Jubjub scalar),  s = k + c'*sk  (mod Jubjub order)
//   verify: s*G == R + c'*pk
// (Compact >= 0.34 has stdlib jubjubSchnorrVerify; this module targets
//  language 0.23 / compiler 0.31.1, which has none.)
// ============================================================
module KycAttestationV1 {
    import CompactStandardLibrary;

    // Claims a CASP attests about one customer (buyer or seller).
    export struct KycAttestation {
        subject: Bytes<32>,         // party role id in the relying contract (roleIdOf(secret))
        wallet: ZswapCoinPublicKey, // shielded wallet key the CASP verified as the customer's
        kycLevel: Uint<8>,          // 1 = basic, 2 = full CDD, 3 = enhanced DD
        amlRiskScore: Uint<8>,      // 0 = lowest risk
        validUntil: Uint<64>,       // unix seconds
        travelRuleRef: Bytes<32>,   // salted commitment to the off-chain Travel Rule (IVMS101) record
        salt: Bytes<32>             // random, keeps kycReference hiding
    }

    export struct SchnorrSignature {
        announcement: JubjubPoint,  // R = k*G
        response: Field             // s = k + c'*sk  (mod Jubjub order)
    }

    // Splits a 255-bit challenge c into q * 2^248 + r (r < 2^248), so r is a
    // valid Jubjub scalar. The circuit checks the split; see verifySchnorr.
    export witness schnorrReduction(c: Field): [Uint<7>, Uint<248>];

    // Message the CASP signs for an attestation: domain tag + all claims.
    export pure circuit kycMessage(att: KycAttestation): Field {
        return transientHash<[Bytes<32>, KycAttestation]>([pad(32, "re-escrow:kyc:v1"), att]);
    }
    // Hiding on-chain reference to an attestation (salted).
    export pure circuit kycReference(att: KycAttestation): Bytes<32> {
        return persistentHash<[Bytes<32>, KycAttestation]>([pad(32, "re-escrow:kyc-ref:v1"), att]);
    }
    // Message the CASP signs to revoke a single attestation by its kycReference.
    export pure circuit kycRevocationMessage(ref: Bytes<32>): Field {
        return transientHash<[Bytes<32>, Bytes<32>]>([pad(32, "re-escrow:kyc-revoke:v1"), ref]);
    }
    // Message the CASP signs to withdraw its own key from a contract's whitelist.
    export pure circuit issuerRevocationMessage(issuerId: Bytes<32>): Field {
        return transientHash<[Bytes<32>, Bytes<32>]>([pad(32, "re-escrow:issuer-revoke:v1"), issuerId]);
    }

    // Schnorr verification. The witness split of the challenge is checked
    // in-circuit and the quotient bounded, so the prover cannot pick an
    // alternative challenge.
    export circuit verifySchnorr(pk: JubjubPoint, msg: Field, sig: SchnorrSignature): Boolean {
        const R = sig.announcement;
        const cFull = transientHash<Vector<5, Field>>(
            [jubjubPointX(R), jubjubPointY(R), jubjubPointX(pk), jubjubPointY(pk), msg]
        );
        const split = schnorrReduction(cFull);
        const q = disclose(split[0]);
        const c = disclose(split[1]);
        assert(q < 116, "Schnorr quotient out of range");
        assert(
            (q as Field) * (452312848583266388373324160190187140051835877600158453279131187530910662656 as Field)
                + (c as Field) == cFull,
            "Schnorr challenge reduction mismatch"
        );
        const lhs = ecMulGenerator(sig.response);
        const rhs = ecAdd(R, ecMul(pk, c as Field));
        return jubjubPointX(lhs) == jubjubPointX(rhs) && jubjubPointY(lhs) == jubjubPointY(rhs);
    }
}
