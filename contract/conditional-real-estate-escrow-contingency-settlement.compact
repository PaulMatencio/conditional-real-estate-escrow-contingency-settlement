pragma language_version >= 0.23;

import CompactStandardLibrary;

// ============================================================
// Conditional real-estate escrow with contingency settlement
//
// Custody model: UNSHIELDED ledger tokens. The contract itself
// holds the funds (receiveUnshielded / sendUnshielded), so the
// escrow state machine and the token movement are atomic.
//
// Strict phases (see contract/compact.md for the full graph):
//
//   Initializing ──configure* / accept (buyer+seller) / finalize (admin)──▶ Created
//      │ (deployed with admin, buyer, seller; other terms may be missing)
//   cancel ──▶ Cancelled
//
//   Created ──fund──▶ Funded ──open review──▶ ContingenciesPending
//      │                 │                      │        │
//   cancel            expire               all cleared  fail/withdraw/expire
//      ▼                 ▼                      ▼        ▼
//   Cancelled         Expired ◀── Disputed ──▶ ReadyToClose / Refunded
//                                                │
//   Settled / Refunded / Expired ──payout──▶ Closed
//
// Every state-changing circuit asserts the exact source phase(s)
// it may run from, so no transition can be skipped or replayed.
// ============================================================

export enum EscrowStatus {
    Initializing,          // deployed, terms still being configured by the admin
    Created,               // deployed, waiting for the buyer's deposit
    Funded,                // deposit held, review not yet opened
    ContingenciesPending,  // attestors submitting outcomes
    ReadyToClose,          // every contingency cleared (or waived)
    Disputed,              // frozen, only the resolver can move it
    Settled,               // approved for release to seller, not yet paid
    Refunded,              // approved for refund to buyer, not yet paid
    Expired,               // refundable to buyer, not yet paid
    Closed,                // funds disbursed (terminal)
    Cancelled              // abandoned before funding, no funds ever held (terminal)
}

// Every term that may be missing at deployment and filled in later
// by the admin. `configured` holds the ones already populated.
export enum InitAttribute {
    Inspector,
    Lender,
    TitleAgent,
    Resolver,
    BuyerPayout,
    SellerPayout,
    EscrowColor,
    EscrowAmount,
    ClosingDeadline,
    DisputeDeadline
}

export enum Contingency {
    Inspection,
    Financing,
    Title
}

export ledger status: EscrowStatus;
export ledger lifecycleRound: Counter;
export ledger correctionCount: Counter;   // how many results the resolver voided
export ledger disbursed: Boolean;

// ------------------------------------------------------------
// Delayed initialization
// ------------------------------------------------------------
export ledger adminId: Bytes<32>;               // configures terms; no power after finalize
export ledger configured: Set<InitAttribute>;   // populated attributes (missing = all - configured)
export ledger configVersion: Counter;           // bumped by every admin change
export ledger buyerAccepted: Boolean;           // reset by every admin change
export ledger sellerAccepted: Boolean;          // reset by every admin change

// Role identities: persistentHash of each role holder's secret key.
// Attestor roles may share an identity with each other (or with the
// buyer, e.g. a cash buyer acting as "lender"), but must be distinct
// from the dispute resolver AND from the seller (separation of duties).
export ledger buyerId: Bytes<32>;
export ledger sellerId: Bytes<32>;
export ledger inspectorId: Bytes<32>;
export ledger lenderId: Bytes<32>;
export ledger titleAgentId: Bytes<32>;
export ledger resolverId: Bytes<32>;

// Payout destinations and escrowed asset
export ledger buyerAddress: UserAddress;
export ledger sellerAddress: UserAddress;
export ledger escrowColor: Bytes<32>;
export ledger escrowAmount: Uint<128>;
export ledger closingDeadline: Uint<64>;   // unix seconds
export ledger disputeDeadline: Uint<64>;   // unix seconds, > closingDeadline

// Contingency results. `submitted` = an outcome is on record,
// `passed` = that outcome is favourable, `waived` = buyer waived it.
export ledger inspectionSubmitted: Boolean;
export ledger inspectionPassed: Boolean;
export ledger inspectionWaived: Boolean;
export ledger financingSubmitted: Boolean;
export ledger financingApproved: Boolean;
export ledger financingWaived: Boolean;
export ledger titleSubmitted: Boolean;
export ledger titleCleared: Boolean;
export ledger titleWaived: Boolean;

witness localSecretKey(): Bytes<32>;

// Only admin, buyer and seller are mandatory at deployment. Every
// other term is a Maybe: pass none() to leave it for later, some(v)
// to set it now. The contract starts in Initializing and is unusable
// until finalizeInitialization() succeeds.
constructor(
    admin: Bytes<32>,
    buyer: Bytes<32>,
    seller: Bytes<32>,
    inspector: Maybe<Bytes<32>>,
    lender: Maybe<Bytes<32>>,
    titleAgent: Maybe<Bytes<32>>,
    resolver: Maybe<Bytes<32>>,
    buyerPayout: Maybe<UserAddress>,
    sellerPayout: Maybe<UserAddress>,
    color: Maybe<Bytes<32>>,
    amount: Maybe<Uint<128>>,
    deadline: Maybe<Uint<64>>,
    disputeEnd: Maybe<Uint<64>>
) {
    adminId = disclose(admin);
    buyerId = disclose(buyer);
    sellerId = disclose(seller);
    assert(buyerId != sellerId, "Buyer and seller must be distinct");
    assert(adminId != buyerId, "Admin must be the seller or a third party, not the buyer");

    status = EscrowStatus.Initializing;
    disbursed = false;
    buyerAccepted = false;
    sellerAccepted = false;
    inspectionSubmitted = false;
    inspectionPassed = false;
    inspectionWaived = false;
    financingSubmitted = false;
    financingApproved = false;
    financingWaived = false;
    titleSubmitted = false;
    titleCleared = false;
    titleWaived = false;

    applyConfig(inspector, lender, titleAgent, resolver, buyerPayout,
                sellerPayout, color, amount, deadline, disputeEnd);
}

// ============================================================
// ACCESS CONTROL (hash of witness secret, never ownPublicKey)
// ============================================================
// Exported so clients can derive the role ids passed to the constructor.
export pure circuit roleIdOf(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "re-escrow:role:"), sk]);
}
circuit roleId(): Bytes<32> {
    return roleIdOf(localSecretKey());
}
circuit onlyBuyer(): [] {
    assert(disclose(roleId() == buyerId), "Caller is not the buyer");
}
circuit onlySeller(): [] {
    assert(disclose(roleId() == sellerId), "Caller is not the seller");
}
circuit onlyAdmin(): [] {
    assert(disclose(roleId() == adminId), "Caller is not the admin");
}
circuit onlyBuyerOrSeller(): [] {
    const id = roleId();
    assert(disclose(id == buyerId) || disclose(id == sellerId), "Caller is not buyer or seller");
}
circuit onlyParty(): [] {
    const id = roleId();
    assert(
        disclose(id == buyerId) || disclose(id == sellerId) || disclose(id == resolverId),
        "Caller is not buyer, seller or resolver"
    );
}
circuit onlyDisputeResolver(): [] {
    assert(disclose(roleId() == resolverId), "Caller is not the dispute resolver");
}
circuit onlyInspector(): [] {
    assert(disclose(roleId() == inspectorId), "Caller is not the inspector");
}
circuit onlyLender(): [] {
    assert(disclose(roleId() == lenderId), "Caller is not the lender");
}
circuit onlyTitleAgent(): [] {
    assert(disclose(roleId() == titleAgentId), "Caller is not the title agent");
}

// ============================================================
// DELAYED INITIALIZATION
// ============================================================
// Number of InitAttribute members; keep in sync with the enum.
circuit isFullyConfigured(): Boolean {
    return configured.size() == 10;
}

// Writes every attribute passed as some(v); none() leaves it unchanged.
// Only single-field sanity checks here; cross-field rules are checked
// once, in finalizeInitialization(), when every value is known.
circuit applyConfig(
    inspector: Maybe<Bytes<32>>,
    lender: Maybe<Bytes<32>>,
    titleAgent: Maybe<Bytes<32>>,
    resolver: Maybe<Bytes<32>>,
    buyerPayout: Maybe<UserAddress>,
    sellerPayout: Maybe<UserAddress>,
    color: Maybe<Bytes<32>>,
    amount: Maybe<Uint<128>>,
    deadline: Maybe<Uint<64>>,
    disputeEnd: Maybe<Uint<64>>
): [] {
    const i = disclose(inspector);
    if (i.is_some) { inspectorId = i.value; configured.insert(InitAttribute.Inspector); }
    const l = disclose(lender);
    if (l.is_some) { lenderId = l.value; configured.insert(InitAttribute.Lender); }
    const t = disclose(titleAgent);
    if (t.is_some) { titleAgentId = t.value; configured.insert(InitAttribute.TitleAgent); }
    const r = disclose(resolver);
    if (r.is_some) { resolverId = r.value; configured.insert(InitAttribute.Resolver); }
    const bp = disclose(buyerPayout);
    if (bp.is_some) { buyerAddress = bp.value; configured.insert(InitAttribute.BuyerPayout); }
    const sp = disclose(sellerPayout);
    if (sp.is_some) { sellerAddress = sp.value; configured.insert(InitAttribute.SellerPayout); }
    const c = disclose(color);
    if (c.is_some) { escrowColor = c.value; configured.insert(InitAttribute.EscrowColor); }
    const a = disclose(amount);
    if (a.is_some) {
        assert(a.value > 0, "Escrow amount must be positive");
        escrowAmount = a.value;
        configured.insert(InitAttribute.EscrowAmount);
    }
    const d = disclose(deadline);
    if (d.is_some) { closingDeadline = d.value; configured.insert(InitAttribute.ClosingDeadline); }
    const de = disclose(disputeEnd);
    if (de.is_some) { disputeDeadline = de.value; configured.insert(InitAttribute.DisputeDeadline); }
}

// Admin populates (or corrects) any subset of the missing terms.
// Any change invalidates earlier buyer/seller acceptances.
export circuit configure(
    inspector: Maybe<Bytes<32>>,
    lender: Maybe<Bytes<32>>,
    titleAgent: Maybe<Bytes<32>>,
    resolver: Maybe<Bytes<32>>,
    buyerPayout: Maybe<UserAddress>,
    sellerPayout: Maybe<UserAddress>,
    color: Maybe<Bytes<32>>,
    amount: Maybe<Uint<128>>,
    deadline: Maybe<Uint<64>>,
    disputeEnd: Maybe<Uint<64>>
): [] {
    assert(status == EscrowStatus.Initializing, "Contract is already initialized");
    onlyAdmin();
    applyConfig(inspector, lender, titleAgent, resolver, buyerPayout,
                sellerPayout, color, amount, deadline, disputeEnd);
    buyerAccepted = false;
    sellerAccepted = false;
    configVersion.increment(1);
}

// Buyer and seller each sign off on the complete configuration they
// read at `expectedVersion`. If the admin changed anything in between,
// the version no longer matches and the acceptance is rejected.
export circuit acceptConfiguration(expectedVersion: Uint<64>): [] {
    assert(status == EscrowStatus.Initializing, "Contract is already initialized");
    assert(isFullyConfigured(), "Configuration is incomplete");
    assert(configVersion.read() == disclose(expectedVersion), "Configuration changed since it was read");
    const id = roleId();
    if (disclose(id == buyerId)) {
        buyerAccepted = true;
    } else {
        assert(disclose(id == sellerId), "Caller is not buyer or seller");
        sellerAccepted = true;
    }
}

// All terms present, valid and accepted by both parties: the contract
// becomes usable (Created). The configuration is frozen from here on
// and the admin role has no further power.
export circuit finalizeInitialization(): [] {
    assert(status == EscrowStatus.Initializing, "Contract is already initialized");
    onlyAdmin();
    assert(isFullyConfigured(), "Configuration is incomplete");
    assert(buyerAccepted && sellerAccepted, "Buyer and seller must accept the configuration");

    assert(buyerId != resolverId, "Buyer must be distinct from dispute resolver");
    assert(sellerId != resolverId, "Seller must be distinct from dispute resolver");
    assert(inspectorId != resolverId, "Inspector must be distinct from dispute resolver");
    assert(lenderId != resolverId, "Lender must be distinct from dispute resolver");
    assert(titleAgentId != resolverId, "Title agent must be distinct from dispute resolver");
    assert(inspectorId != sellerId, "Inspector must be independent from seller");
    assert(lenderId != sellerId, "Lender must be independent from seller");
    assert(titleAgentId != sellerId, "Title agent must be independent from seller");
    assert(disputeDeadline > closingDeadline, "Dispute deadline must follow closing deadline");
    assert(blockTimeLt(closingDeadline), "Closing deadline is already in the past");

    status = EscrowStatus.Created;
    lifecycleRound.increment(1);
}

// ============================================================
// PHASE HELPERS
// ============================================================
circuit allCleared(): Boolean {
    return inspectionSubmitted && inspectionPassed &&
           financingSubmitted && financingApproved &&
           titleSubmitted && titleCleared;
}
circuit anyFailed(): Boolean {
    return (inspectionSubmitted && !inspectionPassed) ||
           (financingSubmitted && !financingApproved) ||
           (titleSubmitted && !titleCleared);
}
circuit advanceIfAllCleared(): [] {
    if (allCleared()) {
        status = EscrowStatus.ReadyToClose;
        lifecycleRound.increment(1);
    }
}

// ============================================================
// SETUP: CANCEL BEFORE FUNDING / DEPOSIT
// ============================================================
// Either side may walk away before any money is locked; while the
// contract is still Initializing the admin may abandon it too.
export circuit cancelBeforeFunding(): [] {
    assert(
        status == EscrowStatus.Initializing || status == EscrowStatus.Created,
        "Escrow already funded"
    );
    const id = roleId();
    assert(
        disclose(id == buyerId) || disclose(id == sellerId) ||
        (status == EscrowStatus.Initializing && disclose(id == adminId)),
        "Caller cannot cancel"
    );
    status = EscrowStatus.Cancelled;
    lifecycleRound.increment(1);
}

export circuit depositToEscrow(): [] {
    assert(status == EscrowStatus.Created, "Escrow is not ready for funding");
    onlyBuyer();
    assert(blockTimeLt(closingDeadline), "Closing deadline has passed");
    receiveUnshielded(escrowColor, escrowAmount);
    status = EscrowStatus.Funded;
    lifecycleRound.increment(1);
}

// ============================================================
// CONTINGENCIES
// ============================================================
export circuit openContingencyReview(): [] {
    assert(status == EscrowStatus.Funded, "Escrow is not funded");
    onlyBuyerOrSeller();
    status = EscrowStatus.ContingenciesPending;
    lifecycleRound.increment(1);
}

// Each contingency outcome is attested ONCE by its designated role.
// A result can only be re-attested after the resolver voided it
// (see voidContingencyResult); nobody can overwrite it in place.
export circuit submitInspection(passed: Boolean): [] {
    assert(status == EscrowStatus.ContingenciesPending, "Not in contingency review");
    assert(!inspectionSubmitted, "Inspection outcome already submitted");
    onlyInspector();
    inspectionSubmitted = true;
    inspectionPassed = disclose(passed);
    advanceIfAllCleared();
}
export circuit submitFinancing(approved: Boolean): [] {
    assert(status == EscrowStatus.ContingenciesPending, "Not in contingency review");
    assert(!financingSubmitted, "Financing outcome already submitted");
    onlyLender();
    financingSubmitted = true;
    financingApproved = disclose(approved);
    advanceIfAllCleared();
}
export circuit submitTitle(cleared: Boolean): [] {
    assert(status == EscrowStatus.ContingenciesPending, "Not in contingency review");
    assert(!titleSubmitted, "Title outcome already submitted");
    onlyTitleAgent();
    titleSubmitted = true;
    titleCleared = disclose(cleared);
    advanceIfAllCleared();
}

// Correction path #1 (buyer only): contingencies protect the buyer,
// so only the buyer may relax one: mark it satisfied whether it is
// still pending or has failed. Irreversible, and recorded as waived.
export circuit waiveContingency(which: Contingency): [] {
    assert(status == EscrowStatus.ContingenciesPending, "Not in contingency review");
    onlyBuyer();
    const c = disclose(which);
    if (c == Contingency.Inspection) {
        assert(!(inspectionSubmitted && inspectionPassed), "Inspection already passed");
        inspectionSubmitted = true;
        inspectionPassed = true;
        inspectionWaived = true;
    } else if (c == Contingency.Financing) {
        assert(!(financingSubmitted && financingApproved), "Financing already approved");
        financingSubmitted = true;
        financingApproved = true;
        financingWaived = true;
    } else {
        assert(!(titleSubmitted && titleCleared), "Title already cleared");
        titleSubmitted = true;
        titleCleared = true;
        titleWaived = true;
    }
    advanceIfAllCleared();
}

// A submitted contingency failed: the buyer may exit with a refund.
export circuit cancelAndRefund(): [] {
    assert(
        status == EscrowStatus.ContingenciesPending,
        "Escrow is not in contingency review"
    );
    onlyBuyer();
    assert(anyFailed(), "No submitted contingency has failed");
    status = EscrowStatus.Refunded;
    lifecycleRound.increment(1);
}

// The seller backs out voluntarily: releases the buyer, who is refunded.
export circuit sellerWithdraw(): [] {
    assert(
        status == EscrowStatus.Funded ||
        status == EscrowStatus.ContingenciesPending ||
        status == EscrowStatus.ReadyToClose,
        "Seller cannot withdraw in current state"
    );
    onlySeller();
    status = EscrowStatus.Refunded;
    lifecycleRound.increment(1);
}

// ============================================================
// EXPIRATION (permissionless keeper call, time-gated)
// ============================================================
// Before closing: past closingDeadline the deal is dead -> refundable.
// While disputed: past disputeDeadline the resolver lost its chance;
// default to refunding the buyer so funds can never be stuck forever.
export circuit expireEscrow(): [] {
    if (status == EscrowStatus.Disputed) {
        assert(blockTimeGte(disputeDeadline), "Dispute deadline has not expired");
    } else {
        assert(
            status == EscrowStatus.Funded ||
            status == EscrowStatus.ContingenciesPending,
            "Escrow cannot expire in current state"
        );
        assert(blockTimeGte(closingDeadline), "Closing deadline has not expired");
    }
    status = EscrowStatus.Expired;
    lifecycleRound.increment(1);
}

// ============================================================
// DISPUTE
// ============================================================
export circuit openDispute(): [] {
    assert(
        status == EscrowStatus.ContingenciesPending ||
        status == EscrowStatus.ReadyToClose,
        "Escrow cannot be disputed in current state"
    );
    onlyBuyerOrSeller();
    assert(blockTimeLt(disputeDeadline), "Dispute window is closed");
    status = EscrowStatus.Disputed;
    lifecycleRound.increment(1);
}

// ============================================================
// DISPUTE RESOLUTION (resolver never writes a contingency value)
// ============================================================
export circuit resolveDisputeRefund(): [] {
    assert(status == EscrowStatus.Disputed, "Escrow is not disputed");
    onlyDisputeResolver();
    status = EscrowStatus.Refunded;
    lifecycleRound.increment(1);
}

// The resolver may only award the seller when every contingency is
// on record as cleared/waived. It cannot turn a failed or pending
// contingency into a payout to the seller.
export circuit resolveDisputeSettlement(): [] {
    assert(status == EscrowStatus.Disputed, "Escrow is not disputed");
    onlyDisputeResolver();
    assert(allCleared(), "Contingencies are not all cleared");
    status = EscrowStatus.Settled;
    lifecycleRound.increment(1);
}

// Correction path #2 (resolver, only inside a dispute): erase a
// contested attestation so the ORIGINAL attestor re-attests it.
// The resolver chooses no value; a buyer waiver cannot be voided.
export circuit voidContingencyResult(which: Contingency): [] {
    assert(status == EscrowStatus.Disputed, "Escrow is not disputed");
    onlyDisputeResolver();
    const c = disclose(which);
    if (c == Contingency.Inspection) {
        assert(inspectionSubmitted && !inspectionWaived, "No attested inspection to void");
        inspectionSubmitted = false;
        inspectionPassed = false;
    } else if (c == Contingency.Financing) {
        assert(financingSubmitted && !financingWaived, "No attested financing to void");
        financingSubmitted = false;
        financingApproved = false;
    } else {
        assert(titleSubmitted && !titleWaived, "No attested title to void");
        titleSubmitted = false;
        titleCleared = false;
    }
    correctionCount.increment(1);
    status = EscrowStatus.ContingenciesPending;
    lifecycleRound.increment(1);
}

// The dispute was unfounded: return to the phase implied by the record.
export circuit dismissDispute(): [] {
    assert(status == EscrowStatus.Disputed, "Escrow is not disputed");
    onlyDisputeResolver();
    if (allCleared()) {
        status = EscrowStatus.ReadyToClose;
    } else {
        status = EscrowStatus.ContingenciesPending;
    }
    lifecycleRound.increment(1);
}

// ============================================================
// CUSTODY: RELEASE / REFUND (the only exits to Closed)
// ============================================================
export circuit releaseToSeller(): [] {
    assert(
        status == EscrowStatus.ReadyToClose || status == EscrowStatus.Settled,
        "Escrow is not releasable to seller"
    );
    assert(!disbursed, "Funds already disbursed");
    if (status == EscrowStatus.ReadyToClose) {
        onlyBuyerOrSeller();
    } else {
        onlyDisputeResolver();
    }
    assert(
        unshieldedBalanceGte(escrowColor, escrowAmount),
        "Escrow balance is insufficient"
    );
    disbursed = true;
    status = EscrowStatus.Closed;
    sendUnshielded(
        escrowColor, escrowAmount,
        right<ContractAddress, UserAddress>(sellerAddress)
    );
    lifecycleRound.increment(1);
}

export circuit refundBuyer(): [] {
    assert(
        status == EscrowStatus.Refunded || status == EscrowStatus.Expired,
        "Escrow is not refundable"
    );
    assert(!disbursed, "Funds already disbursed");
    onlyParty();
    assert(
        unshieldedBalanceGte(escrowColor, escrowAmount),
        "Escrow balance is insufficient"
    );
    disbursed = true;
    status = EscrowStatus.Closed;
    sendUnshielded(
        escrowColor, escrowAmount,
        right<ContractAddress, UserAddress>(buyerAddress)
    );
    lifecycleRound.increment(1);
}
